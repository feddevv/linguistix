{
  "name": "api",
  "type": "module",
  "scripts": {
    "migrate": "node-pg-migrate",
    "migrate:dev": "dotenv -e ../../.env -- pnpm run migrate",
    "migrate:test": "dotenv -e ../../.env.test -- pnpm run migrate",
    "build": "pnpm --filter @repo/shared build && tsc",
    "start": "node ./dist/server.js",
    "dev": "nodemon --exec tsx --env-file=../../.env src/server.ts",
    "test": "pnpm run migrate:test up && dotenv -e ../../.env.test -- vitest --no-file-parallelism",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.4.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "nodemailer": "^10.1.5",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@~7.0.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "msw": "^3.0.3",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "qs": "^6.16.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
