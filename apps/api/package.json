{
  "name": "api",
  "type": "module",
  "scripts": {
    "migrate": "node-pg-migrate",
    "migrate:dev": "dotenv -e ../../.env -- pnpm run migrate",
    "migrate:test": "dotenv -e ../../.env.test -- pnpm run migrate",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "nodemon --exec tsx --env-file=../../.env src/server.ts",
    "test": "pnpm run migrate:test up && dotenv -e ../../.env.test -- vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
